{
  "name": "ai-resume-reviewer-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI Resume Reviewer — Full Stack Application (React 19 & Node.js)",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"npm run frontend\"",
    "dev:all": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run server\" \"npm run frontend\"",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "backend": "npm start --prefix backend",
    "backend:dev": "npm run dev --prefix backend",
    "server": "node --watch-path=backend backend/server.js",
    "server:dev": "node --watch backend/server.js",
    "seed": "node backend/utils/seedDb.js",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "test:backend": "npm test --prefix backend",
    "test:browser": "node tests/e2e.browser.test.js",
    "test:all": "npm test && npm run test:browser",
    "install:all": "npm install --prefix frontend && npm install --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1"
  }
}
