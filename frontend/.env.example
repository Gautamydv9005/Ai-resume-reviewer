# AI Resume Reviewer — Microservices Configuration
# Point these URLs to your respective microservice instances when deployed.
# When unset or unreachable, the frontend automatically falls back to rich mock data.

VITE_USE_MOCK_DATA=true

VITE_AUTH_SERVICE_URL=http://localhost:5001/api/auth
VITE_RESUME_SERVICE_URL=http://localhost:5002/api/resumes
VITE_ANALYSIS_SERVICE_URL=http://localhost:5003/api/analysis
VITE_ATS_SERVICE_URL=http://localhost:5004/api/ats
VITE_JOB_MATCH_SERVICE_URL=http://localhost:5005/api/job-match
VITE_USER_SERVICE_URL=http://localhost:5006/api/users
